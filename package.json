{
  "name": "@wavatec/smart-data-table",
  "version": "0.0.5",
  "description": "Reusable, headless-ish data table for Wavatec apps. Sort/filter/search, multi-select toolbar, column popup, cell context menu, footer aggregations. i18n-ready.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./locales/en.json": "./locales/en.json",
    "./locales/fr.json": "./locales/fr.json"
  },
  "files": [
    "dist",
    "locales",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@tanstack/react-table": ">=8.20.0",
    "clsx": ">=2.0.0",
    "date-fns": ">=3.0.0",
    "exceljs": ">=4.4.0",
    "file-saver": ">=2.0.0",
    "lucide-react": ">=0.450.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-i18next": ">=14.0.0"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.20.0",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.453.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^16.6.6",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
